drought <- seq(0, 1, length.out = 200)
# Conceptual responses
data <- data.frame(
Drought = rep(drought, 2),
beta_leaf = c(
560 - 350 * drought,   # HN: steeper decline
680 - 150 * drought    # LN: moderated decline
),
N_level = rep(c("HN", "LN"), each = 200)
)
# Custom colors
col_N <- c(
"HN" = "#440154",  # dark blue
"LN" = "#AADC32"   # viridis-like green
)
# Plot
Fig1a_H <- ggplot(data, aes(x = Drought, y = beta_leaf,
color = N_level, linetype = N_level)) +
geom_line(linewidth = 1.8) +
scale_color_manual(values = col_N,
labels = c("HN", "LN")) +
scale_linetype_manual(values = c("HN" = "solid",
"LN" = "solid")) +
labs(
x = "Drought severity ",
y = expression(beta[leaf])
) +
theme_classic(base_size = 15) +
theme(
axis.text = element_blank(),
axis.ticks = element_blank(),
legend.position = "right",
legend.title = element_blank(),  # removes legend title
axis.title = element_text(face = "bold")
)
